# CustomerPulse Environment Variables

# Database (default: SQLite for local dev)
# For PostgreSQL: postgresql://user:password@localhost:5432/customerpulse
DATABASE_URL=sqlite:///./customerpulse.db

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=change-this-to-a-random-secret-key
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Upload
MAX_UPLOAD_SIZE_MB=50

# AI Assistant (optional — app works without these)
AI_PROVIDER=none
# Options: none | gemini | openai | anthropic

# Gemini
GEMINI_API_KEY=

# OpenAI
OPENAI_API_KEY=

# Anthropic
ANTHROPIC_API_KEY=

# Demo mode — auto-load demo data on first startup
DEMO_MODE=true
